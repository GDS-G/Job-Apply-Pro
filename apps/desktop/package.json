{
  "name": "@job-apply-pro/desktop",
  "version": "0.12.0-alpha.1",
  "private": true,
  "description": "Job Apply Pro secure desktop shell",
  "author": "GDS-G",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:dir": "electron-builder --config electron-builder.yml --dir --win --x64",
    "package:win": "electron-builder --config electron-builder.yml --win nsis --x64",
    "release:win": "electron-builder --config electron-builder.release.yml --win nsis --x64 --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@job-apply-pro/contracts": "workspace:*",
    "electron-updater": "6.8.9",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.10.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
