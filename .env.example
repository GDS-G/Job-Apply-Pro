JAP_ENVIRONMENT=development
JAP_API_HOST=127.0.0.1
JAP_API_PORT=8765
JAP_DATABASE_URL=sqlite:///./var/job_apply_pro.db
JAP_LOG_LEVEL=INFO
# Generate once with Python's secrets module and store outside source control:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JAP_MASTER_KEY=
# Generated by the Electron main process for managed local-backend sessions.
JAP_API_TOKEN=
JAP_BROWSER_DATA_DIR=./var/browser
JAP_BROWSER_ARTIFACT_DIR=./var/browser-artifacts
JAP_BROWSER_HEADLESS=true
# External sessions require both browser automation and the supervised portal gate.
JAP_AUTOMATION_ENABLED=false
JAP_SUPERVISED_PORTAL_ENABLED=false
JAP_SUPERVISED_PORTAL_SUBMISSION_ENABLED=false
# Comma-separated PortalKind values, for example: LINKEDIN,WORKDAY,GREENHOUSE
JAP_SUPERVISED_PORTAL_ALLOWLIST=
JAP_DOCUMENT_DATA_DIR=./var/documents
JAP_DOCUMENT_MAX_BYTES=10485760
# JSON containing provider secrets, model definitions, and routing policies. Keep local only.
# JAP_AI_CONFIG_JSON={"providers":[],"models":[],"policies":[]}
# Public desktop OAuth client registrations and reviewed scopes. Tokens and passwords are rejected.
# Keep the real client IDs in local configuration rather than committing them here.
# JAP_COMMUNICATION_CONFIG_JSON={"oauth_clients":[{"provider":"GMAIL","client_id":"registered-desktop-client-id","requested_scopes":["openid","email","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.send"]}]}
